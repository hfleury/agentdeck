#!/usr/bin/env python3
"""A stand-in for `claude` in tests: no API calls.

It reads the --settings file agentdeck generated and runs its hook commands
exactly as Claude Code would, and logs every message it receives to
$FAKE_CLAUDE_LOG (JSON lines) so tests can check what arrived.

Messages:
  /...           logged as a command (like Claude's slash commands)
  ask ...        Notification permission_prompt, waits for "y", then Stop
  exit           exits with status 3
  anything else  UserPromptSubmit, a Bash tool call, Stop
A line ending in "\\" continues the message on the next line, as in Claude.
"""
import json, os, subprocess, sys, time, uuid

args = sys.argv[1:]
def opt(name):
    return args[args.index(name) + 1] if name in args else None

session_id = opt("--session-id") or opt("--resume") or str(uuid.uuid4())
settings = json.load(open(opt("--settings"))) if opt("--settings") else {}
log_path = os.environ.get("FAKE_CLAUDE_LOG")
cwd = os.getcwd()
home = os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude"))
transcript = os.path.join(home, "projects", "".join(c if c.isalnum() else "-" for c in cwd), session_id + ".jsonl")

def log(kind, **kw):
    if log_path:
        with open(log_path, "a") as f:
            f.write(json.dumps({"kind": kind, "session": session_id, **kw}) + "\n")

def hook(event, **payload):
    """Run the event's hook commands; return what they printed."""
    out = b""
    for m in settings.get("hooks", {}).get(event, []):
        for h in m.get("hooks", []):
            body = {"session_id": session_id, "transcript_path": transcript, "cwd": cwd,
                    "hook_event_name": event, **payload}
            out += subprocess.run(h["command"], shell=True, input=json.dumps(body).encode(),
                                  capture_output=True, timeout=10).stdout
    return out.decode()

def screen(text):
    sys.stdout.write(text)
    sys.stdout.flush()

log("start", argv=args, cwd=cwd)
screen("\x1b[?2004h")  # ask for bracketed paste, like Claude does
screen(f"fake claude {session_id[:8]}  ({'resumed' if '--resume' in args else 'new'})\n> ")
hook("SessionStart", source="resume" if "--resume" in args else "startup")

def handle(msg, pasted=False):
    # Typed slash commands are commands; pasted text is always a message.
    if msg.startswith("/") and not pasted:
        log("command", text=msg)
        screen(f"[command] {msg}\n> ")
        return
    if msg == "exit":
        log("exit")
        sys.exit(3)
    log("message", text=msg)
    os.makedirs(os.path.dirname(transcript), exist_ok=True)
    with open(transcript, "a") as f:
        f.write(json.dumps({"type": "user", "message": {"content": msg}}) + "\n")
    printed = hook("UserPromptSubmit", prompt=msg)
    if printed.strip():
        ctx = json.loads(printed)["hookSpecificOutput"]["additionalContext"]
        log("context", text=ctx, prompt=msg)
    screen(f"[you] {msg}\n")
    if msg.startswith("ask"):
        hook("Notification", message="Claude needs your permission to use Bash", notification_type="permission_prompt")
        screen("Allow Bash? (y/n) ")
        answer = sys.stdin.readline().strip()
        log("answer", text=answer)
    use_id = "toolu_" + uuid.uuid4().hex[:8]
    if "fail" in msg:
        cmd = {"command": "go test ./..."}
        hook("PreToolUse", tool_name="Bash", tool_input=cmd, tool_use_id=use_id)
        time.sleep(0.2)
        hook("PostToolUseFailure", tool_name="Bash", tool_input=cmd, tool_use_id=use_id,
             error="exit status 1: FAIL TestLogin")
    else:
        cmd = {"command": "echo hi"}
        hook("PreToolUse", tool_name="Bash", tool_input=cmd, tool_use_id=use_id)
        time.sleep(0.2)
        hook("PostToolUse", tool_name="Bash", tool_input=cmd, tool_use_id=use_id, tool_response={"stdout": "hi from " + msg})
    hook("Stop")
    screen("[claude] done\n> ")
    log("turn_done", text=msg)

buf, in_paste, pasted = [], False, False
for raw in sys.stdin:
    line = raw.rstrip("\n")
    if "\x1b[200~" in line:
        in_paste = pasted = True
        line = line.replace("\x1b[200~", "")
    if "\x1b[201~" in line:
        in_paste = False
        line = line.replace("\x1b[201~", "")
    if in_paste:
        buf.append(line)
        continue
    if line.endswith("\\"):
        buf.append(line[:-1])
        continue
    buf.append(line)
    msg = "\n".join(buf).strip("\n")
    buf = []
    if msg:
        handle(msg, pasted)
    pasted = False
